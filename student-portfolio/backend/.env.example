# Copy this file to .env and fill in your real values.
# Never commit the .env file — it is listed in .gitignore.

MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/task_manager
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
PORT=5000

# Your email — this account is automatically made admin on first login/register
ADMIN_EMAIL=your_email_here@gmail.com

# Google OAuth (required for Google Sign-In button)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Gmail for sending verification + password reset emails
# Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_16_chars

FRONTEND_URL=http://localhost:5173
